<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t
        t-name="mail_tracking.Message.notification"
        t-inherit="mail.Message.notification"
        t-inherit-mode="extension"
    >
        <!-- Show the message failure envelope icon in the discuss app -->
        <xpath expr="//div[1]" position="attributes">
            <attribute
                name="t-if"
                add="(env.inDiscussApp and props.thread?.id === 'failed')"
                separator=" or "
            />
        </xpath>
    </t>

    <t
        t-name="mail_tracking.Message"
        t-inherit="mail.Message"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o-mail-Message-header')]" position="after">
            <p
                t-if="props.message.partner_trackings?.length"
                class="o_mail_tracking mb-0"
            >
                <strong>To: </strong>
                <MessageTracking
                    partner_trackings="props.message.partner_trackings"
                    message="props.message"
                />
            </p>
        </xpath>
    </t>

</templates>
